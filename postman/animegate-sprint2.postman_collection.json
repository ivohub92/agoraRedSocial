          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "description": "El backend tiene que estar conectado a MongoDB."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
