    {
      "name": "2 · Listado (GET /publicaciones)",
      "description": "Query params: orden=fecha|meGusta (fecha por defecto), offset y limit para paginar (limit de 1 a 50, 10 por defecto) y usuario=<id> para filtrar.",
      "item": [
        {
          "name": "Listar por defecto (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/publicaciones",
            "description": "Sin parámetros: orden por fecha, offset 0, limit 10. Devuelve { items, total, offset, limit }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Forma { items, total, offset, limit }', () => { pm.expect(r.items).to.be.an('array'); pm.expect(r.total).to.be.a('number'); pm.expect(r.offset).to.eql(0); pm.expect(r.limit).to.eql(10); });",
                  "pm.test('Trae como máximo 10', () => pm.expect(r.items.length).to.be.at.most(10));",
                  "pm.test('Ordenadas por fecha, la más nueva primero', () => { const f = pm.response.json().items.map((p) => Date.parse(p.createdAt)); for (let i = 1; i < f.length; i++) pm.expect(f[i - 1]).to.be.at.least(f[i]); });",
                  "pm.test('La más nueva es el debate de Beto', () => pm.expect(r.items[0]._id).to.eql(pm.collectionVariables.get('idPubBeto')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Paginar: limit=1 (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/publicaciones?offset=0&limit=1",
            "description": "Primera página de a 1."
