          "name": "Crear con imagen (201) · elegir archivo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/publicaciones",
            "description": "ANTES DE ENVIAR: en Body, fila imagen (tipo File) → Select Files → elegir una JPG/PNG (máx. 5 MB). La imagen se guarda (Cloudinary o /uploads) y se devuelve su URL.",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{idAna}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
