                  "key": "titulo",
                  "value": "Captura del episodio 12",
                  "type": "text"
                },
                {
                  "key": "mensaje",
                  "value": "Miren esta escena.",
                  "type": "text"
                },
                {
                  "key": "imagen",
                  "type": "file",
                  "src": [],
                  "description": "Elegir una imagen JPG, PNG, WEBP o GIF de hasta 5 MB"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve la URL de la imagen', () => pm.expect(pm.response.json().imagen).to.match(/^https?:\\/\\//));"
                ]
              }
            }
          ]
        },
