    {
      "name": "1 · Alta (POST /publicaciones)",
      "description": "multipart/form-data con titulo, mensaje, imagen (archivo, opcional) y puntaje (1 a 5, opcional). El usuario que publica va en el header X-Usuario-Id (temporal hasta el JWT del Sprint 3).",
      "item": [
        {
          "name": "Crear reseña con puntaje (201)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/publicaciones",
            "description": "Ana publica una reseña con 4 estrellas. Queda relacionada a su usuario (usuario viene completo, sin contraseña).",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{idAna}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "titulo",
                  "value": "Reseña: Frieren",
                  "type": "text"
                },
                {
                  "key": "mensaje",
                  "value": "Una joya tranquila y emotiva.",
                  "type": "text"
                },
                {
                  "key": "puntaje",
                  "value": "4",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.collectionVariables.set('idPubAna', p._id);",
                  "pm.test('Relacionada a Ana', () => pm.expect(p.usuario._id).to.eql(pm.collectionVariables.get('idAna')));",
                  "pm.test('El autor no trae la contraseña', () => pm.expect(p.usuario).to.not.have.property('password'));",
                  "pm.test('Puntaje 4 como número', () => pm.expect(p.puntaje).to.eql(4));",
                  "pm.test('Arranca con 0 me gusta', () => { pm.expect(p.cantidadMeGusta).to.eql(0); pm.expect(p.meGustaPorMi).to.eql(false); });",
                  "pm.test('Sin imagen: null', () => pm.expect(p.imagen).to.eql(null));",
                  "pm.test('No expone la lista de me gusta ni la baja lógica', () => { const p = pm.response.json(); pm.expect(p).to.not.have.property('meGusta'); pm.expect(p).to.not.have.property('activa'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear debate sin puntaje (201)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/publicaciones",
            "description": "Beto publica un debate: sin puntaje → puntaje null.",
