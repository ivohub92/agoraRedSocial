    {
      "name": "3 · Login (POST /auth/login)",
      "description": "Inicio de sesión con correo o nombre de usuario. El body es JSON.",
      "item": [
        {
          "name": "Login con nombre de usuario (200)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "description": "Devuelve 200 (no 201: el login no crea nada) con los datos del usuario, sin la contraseña.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"{{nombreUsuario}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('No devuelve la contraseña', () => pm.expect(pm.response.json()).to.not.have.property('password'));",
                  "pm.test('Es el usuario correcto', () => pm.expect(pm.response.json().nombreUsuario).to.eql(pm.collectionVariables.get('nombreUsuario')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con correo (200)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
