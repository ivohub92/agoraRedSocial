{
  "info": {
    "name": "Ágora · Sprint 1",
    "description": "Consultas de la API del Sprint 1 (registro y login).\n\n• Cambiar la variable baseUrl para probar en local (http://localhost:3000) o en Render.\n• Correr con \"Run collection\" respetando el orden: \"Registro OK\" crea el usuario que usan los demás.\n• Los pedidos marcados \"elegir archivo\" necesitan seleccionar una imagen a mano en Body (no los incluyas en el Runner, o elegí el archivo antes).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "correo",
      "value": "prueba@test.com"
    },
    {
      "key": "correoMayus",
      "value": "PRUEBA@TEST.COM"
    },
    {
      "key": "nombreUsuario",
      "value": "prueba"
    },
    {
      "key": "password",
      "value": "Clave1234"
    },
    {
      "key": "mensaje401",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 · Estado del servidor",
      "description": "Verifica que el backend esté prendido y conectado a MongoDB.",
      "item": [
        {
          "name": "Salud del backend (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "description": "GET / → 200 si el backend está conectado a MongoDB; 503 con el motivo si no. En Render, el primer pedido puede tardar ~50 s si el servicio estaba dormido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Conectado a MongoDB', () => pm.expect(pm.response.json().mongo).to.eql('conectado'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Registro (POST /auth/registro)",
      "description": "Alta de usuarios. El body es multipart/form-data porque puede llevar la imagen de perfil.",
      "item": [
        {
          "name": "Registro OK (201)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/registro",
            "description": "Crea un usuario nuevo. El pre-request script genera correo y usuario únicos en cada corrida, así la colección se puede ejecutar muchas veces.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Juan",
                  "type": "text"
                },
                {
                  "key": "apellido",
                  "value": "Pérez",
                  "type": "text"
                },
                {
                  "key": "correo",
                  "value": "{{correo}}",
                  "type": "text"
                },
                {
                  "key": "nombreUsuario",
                  "value": "{{nombreUsuario}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "repetirPassword",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "fechaNacimiento",
                  "value": "2000-05-10",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "Usuario de prueba",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera correo y usuario únicos para poder correr la colección muchas veces",
                  "const n = Date.now();",
                  "pm.collectionVariables.set('correo', `prueba${n}@test.com`);",
                  "pm.collectionVariables.set('nombreUsuario', `prueba${n}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test('No devuelve la contraseña', () => pm.expect(pm.response.json()).to.not.have.property('password'));",
                  "pm.test('Perfil por defecto: usuario', () => pm.expect(u.perfil).to.eql('usuario'));",
                  "pm.test('Correo guardado en minúsculas', () => pm.expect(u.correo).to.eql(pm.collectionVariables.get('correo').toLowerCase()));",
                  "pm.test('Tiene _id y createdAt', () => { pm.expect(u._id).to.be.a('string'); pm.expect(u.createdAt).to.be.a('string'); });",
                  "pm.test('Sin imagen: imagenPerfil es null', () => pm.expect(u.imagenPerfil).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro con imagen de perfil (201) · elegir archivo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/registro",
            "description": "ANTES DE ENVIAR: en Body, fila imagenPerfil (tipo File) → Select Files → elegir una imagen JPG/PNG (máx. 5 MB). Devuelve la URL de la imagen (Cloudinary o /uploads).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "Juan",
                  "type": "text"
                },
                {
                  "key": "apellido",
                  "value": "Pérez",
                  "type": "text"
                },
                {
                  "key": "correo",
                  "value": "foto{{$timestamp}}@test.com",
                  "type": "text"
                },
                {
                  "key": "nombreUsuario",
                  "value": "foto{{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "repetirPassword",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "fechaNacimiento",
                  "value": "2000-05-10",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "Usuario de prueba",
                  "type": "text"
                },
                {
                  "key": "imagenPerfil",
                  "type": "file",
                  "src": [],
                  "description": "Elegir una imagen JPG, PNG, WEBP o GIF de hasta 5 MB"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('No devuelve la contraseña', () => pm.expect(pm.response.json()).to.not.have.property('password'));",
                  "pm.test('Devuelve la URL de la imagen', () => pm.expect(pm.response.json().imagenPerfil).to.match(/^https?:\\/\\//));"
                ]
              }
            }
          ]
        },
